# Kratos — environment template.
# Copy to .env and adjust. App variables are read with the KRATOS_ prefix.

# --- Local development ----------------------------------------------------
# docker compose -f docker-compose.dev.yml up -d
KRATOS_DATABASE_URL=postgresql+psycopg://kratos:kratos@localhost:5432/kratos

KRATOS_ENVIRONMENT=development
KRATOS_LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API from a browser.
KRATOS_CORS_ORIGINS=http://localhost:5173

# --- Web build ------------------------------------------------------------
# Prefix the browser uses for API calls. The default, /api, is same-origin —
# the dev server and the deployed reverse proxy both route it to the service.
# Set this only for a split deployment where the API lives elsewhere.
VITE_API_BASE_URL=/api

# --- Deployed stack (docker-compose.yml) ----------------------------------
# These are supplied by the environment, not read from this file. The deploy
# workflow sets them from repository variables; on the host, export them or
# put them in a .env next to the compose file.
#
#   DOMAIN_NAME                     apex domain Traefik matches; the app is
#                                   served at kratos.${DOMAIN_NAME}
#   REGISTRY_PREFIX                 image prefix, e.g. registry.example.net/
#   STACK_NAME                      swarm stack name; also the image tag
#   KRATOS_DB_MOUNT_PATH            host path for the database bind mount
#                                   (default /opt/kratos/data)
#
# The database password is hardcoded to `kratos` in docker-compose.yml and is
# not set here. See README, "The database password".
